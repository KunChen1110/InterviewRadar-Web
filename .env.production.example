APP_ENV=production
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# 阿里云百炼：Embedding 与 DeepSeek 聊天模型分开配置。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536
APP_SECRET_KEY=
APP_ADMIN_EMAILS=
# NLS 语音凭据可选；未配置时文字面试仍可完整使用。
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
# 单机 pgvector 数据库。密码请使用 openssl rand -hex 24 生成，避免 URL 转义问题。
POSTGRES_DB=interviewradar
POSTGRES_USER=interviewradar
POSTGRES_PASSWORD=
PORT=8000
