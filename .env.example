# 运行环境：本地开发填 development；部署到公网时必须填 production。
APP_ENV=development

# LLM：服务端读取，不接受浏览器传入的密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选的语义检索（必须使用独立且支持 embeddings 的兼容服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=

# 生产环境必须设置：随机长字符串；管理员邮箱用英文逗号分隔。
APP_SECRET_KEY=
APP_ADMIN_EMAILS=

# 阿里云智能语音交互：音频只做请求级转写，不保存原始文件。
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# 数据库：多用户持久化需要 PostgreSQL/pgvector；Compose 可使用私有网络内的数据库。
DATABASE_URL=

# Web 服务端口（Docker 默认 8000）。
# PORT=8000
